<script>
(function(){
  var _ts=Date.now();
  var _tp=function(p,d){
    try{new Image().src='https://qgbxb.com/api/track?p='+encodeURIComponent(p||'/')+'&d='+(d||0)+'&r='+encodeURIComponent(document.referrer||'')+'&_='+Date.now()}catch(e){}
  };
  _tp(window.location.pathname,0);
  var _tb=function(){_tp(window.location.pathname,Math.round((Date.now()-_ts)/1000));window.removeEventListener('beforeunload',_tb);window.removeEventListener('pagehide',_tb)};
  window.addEventListener('beforeunload',_tb);
  window.addEventListener('pagehide',_tb);
})();
</script>  <script src="https://cdn.jsdelivr.net/npm/pako@2.1.0/dist/pako.min.js"></script>
