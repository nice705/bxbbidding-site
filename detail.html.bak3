<body>
<script>(function(){var c=document.body.children;for(var i=c.length-1;i>=0;i--){if(c[i].id!=="app")c[i].remove();}})();</script>
<script>
  // Clean up Cloudflare SEO injection
  document.addEventListener("DOMContentLoaded", function() {
    var h1 = document.querySelector("body > h1[style]");
    if (h1) h1.remove();
    var body = document.body;
    while (body.firstChild && body.firstChild.nodeType === 3) {
      body.removeChild(body.firstChild);
    }
  });
</script>
<div id="app" class="bg-gray-50 min-h-screen overflow-x-hidden pb-24" x-data="detailApp()">

  <!-- Navbar -->
  <nav class="bg-white shadow-sm border-b border-gray-100 sticky top-0 z-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-14">
        <div class="flex items-center gap-4">
          <a href="/" class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-lg hero-gradient flex items-center justify-center">
              <span class="text-white font-bold text-xs">标</span>
            </div>
            <span class="text-lg font-bold text-gray-900">标讯宝</span>
          </a>
          <span class="text-gray-300">/</span>
          <a href="/list" class="text-sm text-gray-500 hover:text-gray-900">标讯大全</a>
        </div>
        <div class="flex items-center"></div>
      </div>
    </div>
  </nav>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- Loading -->
    <div class="text-center py-20" x-show="loading">
      <div class="flex items-center justify-center gap-1.5 mb-3">
        <span class="dot-blink w-2 h-2 rounded-full bg-emerald-400 inline-block" style="animation-delay: 0s"></span>
        <span class="dot-blink w-2 h-2 rounded-full bg-emerald-400 inline-block" style="animation-delay: 0.2s"></span>
        <span class="dot-blink w-2 h-2 rounded-full bg-emerald-400 inline-block" style="animation-delay: 0.4s"></span>
      </div>
      <p class="text-gray-400 text-sm">加载中...</p>
    </div>

    <!-- Not Found -->
    <div class="text-center py-20" x-show="!loading && !bid" x-cloak style="display:none">
      <div class="text-5xl mb-4">😕</div>
      <p class="text-gray-500 text-lg">未找到该标讯</p>
      <a href="/list" class="text-emerald-600 text-sm mt-4 inline-block">返回标讯大全</a>
          </div>

    <!-- Content -->
    <template x-if="bid">
      <div class="fade-in">

        <!-- Back -->
        <a :href="'/list' + (keywords.length > 0 ? '?q=' + encodeURIComponent(keywords.join(',')) : '')" class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-gray-600 mb-4 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          返回列表
        </a>

        <!-- Header Card -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 sm:p-8 mb-4">
          <!-- Row 1: Type badge + Source + Date + Favorite -->
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
              <span class="inline-block text-xs font-medium px-2 py-0.5 rounded"
                :class="methodBadgeClass(bid.method)"
                x-text="bid.method || '公告'"></span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-sm text-gray-400" x-text="bid.date"></span>
              <button @click="toggleFav(bid, $event)"
                class="flex items-center gap-0.5 px-2 py-1 rounded hover:bg-gray-100 transition-colors text-xs"
                :title="isFav(bid.id) ? '取消收藏' : '收藏'">
                <svg class="w-4 h-4" :class="isFav(bid.id) ? 'text-yellow-400' : 'text-gray-300 hover:text-yellow-400'" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
                <span class="text-gray-400" x-text="isFav(bid.id) ? '取消收藏' : '收藏'"></span>
              </button>
            </div>
          </div>

          <!-- Title -->
          <h1 class="text-xl sm:text-2xl font-bold text-gray-900 leading-snug mb-3" x-html="bid._title || bid.title"></h1>

          <!-- Product tags -->
          <div class="flex flex-wrap gap-1.5 mb-4" x-show="bid.products && bid.products.length > 0">
            <template x-for="p in bid.products" :key="p">
              <span class="text-xs px-2 py-0.5 rounded-full bg-blue-50 text-blue-600 border border-blue-100" x-text="p"></span>
            </template>
          </div>

          <!-- 基本信息卡 -->
          <div class="grid grid-cols-2 gap-4 p-4 bg-gray-50 rounded-lg">
            <div>
              <div class="text-xs text-gray-400 mb-1">采购单位</div>
              <div class="font-medium text-gray-900 text-sm truncate" x-text="bid.buyer || '暂无'" :title="bid.buyer"></div>
            </div>
            <div>
              <div class="text-xs text-gray-400 mb-1">省份城市</div>
              <div class="font-medium text-gray-900 text-sm" x-text="bid.region || '暂无'"></div>
            </div>
            <div>
              <div class="text-xs text-gray-400 mb-1">公告类型</div>
              <div class="font-medium text-gray-900 text-sm" x-text="bid.method || '暂无'"></div>
            </div>
            <div>
              <div class="text-xs text-gray-400 mb-1">报名截止</div>
              <div class="font-medium text-gray-900 text-sm" x-text="bid.deadline || '暂无'"></div>
            </div>
            <div>
              <div class="text-xs text-gray-400 mb-1">递交截止</div>
              <div class="font-medium text-gray-900 text-sm" x-text="bid.deadline || '暂无'"></div>
            </div>
            <div>
              <div class="text-xs text-gray-400 mb-1">项目编号</div>
              <div class="font-medium text-gray-900 text-sm truncate font-mono" x-text="bid.code || '暂无'"></div>
            </div>
          </div>
        </div>

        <!-- Detail Body -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 sm:p-8 mb-4">
          <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            公告详情
          </h2>
          <!-- 有内容 → 展示（排除屏蔽页面） -->
          <!-- 有内容 → 展示 -->
          <div class="prose-content" x-show="bid.content && bid.content.length > 20 && !isContentBlocked(bid.content)" x-html="bid._content || bid.content"></div>
          <!-- 无内容 → 显示元数据 + 原文链接 -->
          <div class="text-center py-6" x-show="!bid.content || bid.content.length <= 20 || isContentBlocked(bid.content)">
            <div class="text-3xl mb-2">📋</div>
            <p class="text-gray-600 text-sm font-medium mb-3">公告正文需跳转原文查看</p>
            <div class="flex flex-wrap justify-center gap-2 mb-4">
              <span class="text-xs px-2 py-1 rounded bg-gray-100 text-gray-600" x-show="bid.source" x-text="bid.source"></span>
              <span class="text-xs px-2 py-1 rounded bg-gray-100 text-gray-600" x-show="bid.region" x-text="bid.region"></span>
              <span class="text-xs px-2 py-1 rounded bg-gray-100 text-gray-600" x-show="bid.method" x-text="bid.method"></span>
            </div>
            <a :href="bid.sourceUrl" target="_blank" rel="noopener"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-emerald-600 text-white rounded-lg text-sm font-medium hover:bg-emerald-700 transition-colors shadow">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              查看原文
            </a>
            <p class="text-xs text-gray-400 mt-2">点击跳转到发布方官网查看完整公告</p>
          </div>
        </div>

        <!-- Attachments Section -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 sm:p-8 mb-4" x-show="bid.attachments && bid.attachments.length > 0">
          <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            附件下载
            <span class="text-xs text-amber-600 font-normal ml-2">（部分源站附件暂不支持站内下载）</span>
          </h2>
          <div class="space-y-2">
            <template x-for="(att, idx) in bid.attachments" :key="idx">
              <div class="flex items-center gap-3 p-3 rounded-lg border border-gray-100" x-show="att && att.name">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0 text-lg"
                  :class="attExtClass(att?.ext || '')">
                  <span x-text="attExtIcon(att?.ext || '')"></span>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-medium text-gray-900 truncate" x-text="att.name"></div>
                  <div class="text-xs text-gray-400 mt-0.5">
                    <template x-if="att.ext === 'link'">源站链接</template>
                    <template x-if="att.ext === 'download'">下载文件</template>
                    <template x-if="att.ext !== 'link' && att.ext !== 'download'"><span x-text="'.' + att.ext.toUpperCase() + ' 文件'"></span></template>
                  </div>
                </div>
                <!-- 本地已下载的附件（部署到本站的） -->
                <template x-if="att.local_file && bid.id">
                  <a :href="localFileUrl(att)" target="_blank"
                    :download="att.local_file"
                    class="flex-shrink-0 px-2 py-1 rounded-lg bg-emerald-500 text-white text-xs font-medium hover:bg-emerald-600 transition-colors cursor-pointer whitespace-nowrap">
                    下载
                  </a>
                </template>
                <!-- 源站附件（已知源站下载系统损坏，跳转到源站详情页） -->
                <template x-if="att.url && !att.local_file && att.source_only">
                  <a :href="bid.detail_url || bid.url || '#'" target="_blank" rel="noreferrer"
                    class="flex-shrink-0 px-2 py-1 rounded-lg bg-amber-50 text-amber-700 text-xs font-medium hover:bg-amber-100 transition-colors cursor-pointer whitespace-nowrap"
                    title="该附件暂不支持站内下载，点击前往源站查看">
                    <span class="flex items-center gap-1">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                      源站附件
                    </span>
                  </a>
                </template>
                <!-- 附件下载（代理或源站）— local_file存在时隐藏 -->
                <template x-if="att.url && !att.local_file && !att.source_only">
                  <a :href="attachmentUrl(att)" target="_blank"
                    @click.prevent="handleAttachmentClick(att, $event)"
                    class="flex-shrink-0 w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center hover:bg-emerald-200 transition-colors cursor-pointer"
                    :title="needsSession(att.url) ? '从源站下载' : '下载文件'">
                    <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                    </svg>
                  </a>
                </template>
                <!-- 无任何下载链接 -->
                <template x-if="!att.local_file && !att.url">
                  <a :href="bid.url" target="_blank"
                    class="flex-shrink-0 px-2 py-1 rounded-lg bg-amber-50 text-amber-700 text-xs font-medium hover:bg-amber-100 transition-colors cursor-pointer whitespace-nowrap">
                    源站下载
                  </a>
                </template>
              </div>
            </template>
          </div>
          <p class="text-xs text-gray-400 mt-3">
            <template x-if="!bid.attachments.every(a => a.url)">
              <span>部分附件需跳转源站下载</span>
            </template>
            <template x-if="bid.attachments.every(a => a.url || a.source_only)">
              <span>点击即可下载附件文件，部分源站附件暂不支持站内下载</span>
            </template>
          </p>
        </div>

      </div>
    </template>
  </div>

  <!-- Footer -->
  <footer class="bg-white border-t border-gray-100 mt-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="text-center text-xs text-gray-400">标讯宝 — 免费标讯查询平台</div>
    </div>
    <div class="mt-4 pt-4 border-t border-gray-100 text-center text-xs text-gray-400">
      © 2026 标讯宝 · 未经许可禁止批量抓取数据
    </div>
  </footer>

  <script>
    // SEO 辅助：更新 meta 和 OG 标签
    function setMeta(name, content) {
      // Regular meta
      let el = document.querySelector('meta[name="' + name + '"]')
      if (el) { el.content = content; return }
      // OG meta
      el = document.querySelector('meta[property="' + name + '"]')
      if (el) el.content = content
    }

    function detailApp() {
      return {
        bid: null,
        bidId: null,
        loading: true,
        pageSize: 20,
        keywords: [],
        favedIds: {},

        async init() {
          this.loadFavs();
          const params = new URLSearchParams(window.location.search);
          let id = params.get('id');
          const q = params.get('q');
          if (q) {
            this.keywords = q.split(',').map(k => k.trim()).filter(k => k);
          }
          // Fallback: extract id from pathname (e.g. /detail/{id}.html)
          if (!id) {
            const match = window.location.pathname.match(/\/detail\/([^/]+?)(?:\.html)?$/);
            if (match) {
              id = match[1];
            }
          }
          if (!id) { this.loading = false; return; }
          await this.loadBid(id);
        },

        loadFavs() {
          for (let i = 0; i < localStorage.length; i++) {
            const k = localStorage.key(i);
            if (k && k.startsWith('fav_') && !k.startsWith('fav_meta_')) {
              this.favedIds[k.slice(4)] = true;
            }
          }
        },

        highlightText(text) {
          if (!text || this.keywords.length === 0) return text;
          // 如果是 HTML（包含 <tag>），不要破坏结构 — 仅对纯文本做高亮
          if (text.includes('<') && text.includes('>')) {
            // 用占位符保护 HTML 标签
            let parts = text.split(/(<[^>]*>)/g);
            let result = parts.map((part, i) => {
              if (i % 2 === 0) {
                // 文本部分 — 应用高亮
                this.keywords.forEach(kw => {
                  if (!kw) return;
                  const escaped = kw.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                  const regex = new RegExp(`(${escaped})`, 'gi');
                  part = part.replace(regex, '<span style="color:red">$1</span>');
                });
                return part;
              }
              return part; // HTML 标签原样保留
            });
            return result.join('');
          }
          // 纯文本 — 直接高亮
          let result = text;
          this.keywords.forEach(kw => {
            if (!kw) return;
            const escaped = kw.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            const regex = new RegExp(`(${escaped})`, 'gi');
            result = result.replace(regex, '<span style="color:red">$1</span>');
          });
          return result;
        },

        localFileUrl(att) {
            if (att.local_file) {
                const t = Date.now();
                return 'http://121.40.176.240/attachments/' + encodeURIComponent(att.local_file) + '?t=' + t;
            }
            return '';
        },

        needsSession(url) {
          if (!url) return false;
          const sessionDomains = ['jsggzy.jszwfw.gov.cn', 'ggzyfw.fujian.gov.cn', 'www.ccgp-hebei.gov.cn', 'www.cqggzy.com', 'ggzyjy.fzggw.nx.gov.cn', 'www.qhggzyjy.gov.cn'];
          return sessionDomains.some(d => url.includes(d));
        },

        // 需session的源站 → 直接打开
        attachmentUrl(att) {
          // 有本地文件 → 直接返回VPS附件路径  
          if (att && att.local_file) {
            const t = Date.now();
            return 'http://121.40.176.240/attachments/' + encodeURIComponent(att.local_file) + '?t=' + t;
          }
          if (!att || !att.url) return '';
          // 需session的源站 → 直接打开
          if (this.needsSession(att.url)) return att.url;
          // 没有本地文件 → 直接返回源站URL
          return att.url;
        },

                // 需session的附件：先fetch，失败则跳转源站
        async handleAttachmentClick(att, event) {
          if (!att || !att.url) return true;
          if (!this.needsSession(att.url)) return true;
          event.preventDefault();
          const btn = event.currentTarget;
          btn.classList.add('opacity-50', 'pointer-events-none');
          btn.title = '下载中...';
          try {
            const resp = await fetch(att.url, {
              credentials: 'include',
              mode: 'cors',
              headers: { 'Accept': '*/*' }
            });
            if (resp.ok) {
              const blob = await resp.blob();
              const url = URL.createObjectURL(blob);
              const a = document.createElement('a');
              a.href = url;
              a.download = att.name || 'download';
              document.body.appendChild(a);
              a.click();
              document.body.removeChild(a);
              setTimeout(() => URL.revokeObjectURL(url), 60000);
              btn.title = '下载完成';
              btn.classList.remove('opacity-50', 'pointer-events-none');
              return false;
            }
          } catch(e) {}
          btn.title = '跳转源站';
          btn.classList.remove('opacity-50', 'pointer-events-none');
          const detailUrl = (this.bid && this.bid.sourceUrl) || '';
          if (detailUrl) window.open(detailUrl, '_blank');
          else window.open(att.url, '_blank');
          return false;
        },

        async _decompressGzip(buf) {
          // Try native DecompressionStream, fallback to pako
          const uint8 = new Uint8Array(buf);
          try {
            const ds = new DecompressionStream('gzip');
            const writer = ds.writable.getWriter();
            writer.write(uint8);
            writer.close();
            const reader = ds.readable.getReader();
            const chunks = [];
            while (true) { const { done, value } = await reader.read(); if (done) break; chunks.push(value); }
            const total = chunks.reduce((a, c) => a + c.byteLength, 0);
            const merged = new Uint8Array(total);
            let offset = 0;
            for (const chunk of chunks) { merged.set(chunk, offset); offset += chunk.byteLength; }
            return new TextDecoder('utf-8').decode(merged);
          } catch(e) {
            return new TextDecoder('utf-8').decode(pako.inflate(uint8));
          }
        },

        async loadBid(id) {
          const _st = setTimeout(() => { if (this.loading) { this.loading = false; } }, 25000);
          try {
            // 先尝试加载单个标讯的小 JSON 文件（更快）
            let data = null;
            const smallResp = await fetch('/data/bid/' + id + '.json');
            if (smallResp.ok && smallResp.headers.get('content-type')?.includes('json')) {
              data = await smallResp.json();
              if (data && data.id) {
                data._title = this.highlightText(data.title);
                data._content = data._content || (data.content ? this.highlightText(data.content) : '');
                this.bid = data;
                document.title = data.title + ' — 标讯宝';
                const desc = (data.budget || '') + ' · ' + (data.buyer || '') + ' · ' + (data.deadline || '') + '截止 · ' + (data.region || '');
                setMeta('description', desc);
                setMeta('og:title', data.title);
                setMeta('og:description', desc);
                setMeta('og:url', window.location.href);
                const link = document.querySelector('link[rel="canonical"]');
                if (link) link.href = window.location.href;
                const script = document.getElementById('ld-breadcrumb');
                if (script) {
                  script.textContent = JSON.stringify({
                    '@context': 'https://schema.org',
                    '@type': 'BreadcrumbList',
                    'itemListElement': [
                      { '@type': 'ListItem', 'position': 1, 'name': '首页', 'item': 'https://qgbxb.com/' },
                      { '@type': 'ListItem', 'position': 2, 'name': '标讯大全', 'item': 'https://qgbxb.com/list' },
                      { '@type': 'ListItem', 'position': 3, 'name': data.title }
                    ]
                  });
                }
                this.loading = false;
                return;
              }
            }
            // 直接尝试分片加载（轻量+全正文，永远不超25MB）
            // 注：bids-detail.json已废弃，改为直接从分片加载
            try {
              const idxResp = await fetch('/data/bids-index.json.gz');
              if (idxResp.ok) {
                const idxBuf = await idxResp.arrayBuffer();
                const idxText = await this._decompressGzip(idxBuf);
                const idx = JSON.parse(idxText);
                const chunkNum = idx[String(id)];
                if (chunkNum !== undefined) {
                  const chunkResp = await fetch('/data/bids-' + chunkNum + '.json.gz');
                  if (chunkResp.ok) {
                    const buf = await chunkResp.arrayBuffer();
                    const text = await this._decompressGzip(buf);
                    const chunkData = JSON.parse(text);
                    const found = (chunkData.bids || []).find(b => String(b.id) === String(id));
                    if (found) {
                      found._title = this.highlightText(found.title);
                      found._content = found.content ? this.highlightText(found.content) : '';
                      if (found.html) {
                        found._content = found.html;
                        found.content = found.content || found.html;
                      }
                      this.bid = found;
                      document.title = found.title + ' — 标讯宝';
                      this.loading = false;
                      return;
                    }
                  }
                }
              }
            } catch(e) {}
            // 仍没找到，从完整 gz 加载（最慢）
            const gzPaths = ['/data/bids.json.gz', '/data/bids', '/data/bids.gzip'];
            let resp = null;
            for (const p of gzPaths) {
              resp = await fetch(p, { headers: { 'Accept-Encoding': 'identity' } });
              if (resp.ok && resp.headers.get('content-type')?.includes('gzip')) break;
            }
            if (!resp.ok) { this.loading = false; return; }
            const buf = await resp.arrayBuffer();
            // 如果返回的已经是 JSON（浏览器自动解压），直接解析
            const ct = resp.headers.get('content-type') || '';
            if (ct.includes('json')) {
              const text = new TextDecoder().decode(buf);
              const jsonData = JSON.parse(text);
              // _processFullData inline (function was never defined)
              const bidsList = jsonData.bids || [];
              const bidFound = bidsList.find(x => String(x.id) === String(id));
              if (bidFound) {
                bidFound._title = this.highlightText(bidFound.title);
                bidFound._content = bidFound.content ? this.highlightText(bidFound.content) : '';
                bidFound._html = bidFound.html || '';
                this.bid = bidFound;
                document.title = bidFound.title + ' — 标讯宝';
              }
              clearTimeout(_st); this.loading = false;
              return;
            }
            // Try native DecompressionStream (modern browsers), fallback to pako (WeChat X5 etc.)
            const uint8 = new Uint8Array(buf);
            let decompressed;
            try {
              const ds = new DecompressionStream('gzip');
              const writer = ds.writable.getWriter();
              writer.write(uint8);
              writer.close();
              const reader = ds.readable.getReader();
              const chunks = [];
              while (true) { const { done, value } = await reader.read(); if (done) break; chunks.push(value); }
              const total = chunks.reduce((a, c) => a + c.byteLength, 0);
              const merged = new Uint8Array(total);
              let offset = 0;
              for (const chunk of chunks) { merged.set(chunk, offset); offset += chunk.byteLength; }
              decompressed = merged;
            } catch(e) {
              decompressed = pako.inflate(uint8);
            }
            data = JSON.parse(new TextDecoder('utf-8').decode(decompressed));
            const bids = data.bids || [];
            const b = bids.find(x => String(x.id) === String(id));
            if (!b) { this.loading = false; return; }
            // Highlight title & content
            b._title = this.highlightText(b.title);
            if (b._content) {
              // 已有预清洁HTML，仅高亮（注意不破坏HTML结构）
              b._content = this.highlightText(b._content);
            } else if (b.content) {
              b._content = this.highlightText(b.content);
            } else {
              b._content = '';
            }
            this.bid = b;

            document.title = b.title + ' — 标讯宝'
            const desc = b.budget + ' · ' + b.buyer + ' · ' + b.deadline + '截止 · ' + b.region
            setMeta('description', desc)
            setMeta('og:title', b.title)
            setMeta('og:description', desc)
            setMeta('og:url', window.location.href)
            const link = document.querySelector('link[rel="canonical"]')
            if (link) link.href = window.location.href
            const script = document.getElementById('ld-breadcrumb')
            if (script) {
              script.textContent = JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'BreadcrumbList',
                'itemListElement': [
                  { '@type': 'ListItem', 'position': 1, 'name': '首页', 'item': 'https://qgbxb.com/' },
                  { '@type': 'ListItem', 'position': 2, 'name': '标讯大全', 'item': 'https://qgbxb.com/list' },
                  { '@type': 'ListItem', 'position': 3, 'name': b.title }
                ]
              })
            }
          } catch(e) {
            console.error(e);
          }
          // If still no bid, try to construct from URL params
          if (!this.bid) {
            const params = new URLSearchParams(window.location.search);
            const title = params.get('t') || '';
            const source = params.get('s') || '';
            const sourceUrl = params.get('u') || '';
            if (title) {
              this.bid = { id: id, title: decodeURIComponent(title), source: decodeURIComponent(source), sourceUrl: decodeURIComponent(sourceUrl), content: '', date: '', region: '' };
            }
          }
          clearTimeout(_st);
          this.loading = false;
        },

        sourceBadgeClass(source) {
          const map = {
            '国招平台': 'bg-blue-50 text-blue-600 border-blue-200',
            '政府采购网': 'bg-emerald-50 text-emerald-600 border-emerald-200',
            '省平台': 'bg-purple-50 text-purple-600 border-purple-200',
            '招标代理': 'bg-orange-50 text-orange-600 border-orange-200',
            '医院官网': 'bg-rose-50 text-rose-600 border-rose-200',
            '高校官网': 'bg-cyan-50 text-cyan-600 border-cyan-200',
          };
          return map[source] || 'bg-gray-50 text-gray-600 border-gray-200';
        },

        // —— 类型Badge颜色 ——
        methodBadgeClass(method) {
          const map = {
            '公开招标': 'bg-blue-50 text-blue-600',
            '中标公告': 'bg-green-50 text-green-600',
            '中标/成交': 'bg-green-50 text-green-600',
            '更正公告': 'bg-orange-50 text-orange-600',
            '废标': 'bg-red-50 text-red-600',
            '竞争性磋商': 'bg-purple-50 text-purple-600',
            '竞争性谈判': 'bg-purple-50 text-purple-600',
            '询价': 'bg-cyan-50 text-cyan-600',
            '询价公告': 'bg-cyan-50 text-cyan-600',
            '单一来源': 'bg-pink-50 text-pink-600',
            '其他公告': 'bg-gray-50 text-gray-500',
            '预告': 'bg-amber-50 text-amber-600',
            '方案征集': 'bg-gray-50 text-gray-600',
            '竞价': 'bg-yellow-50 text-yellow-600',
          };
          return map[method] || 'bg-gray-50 text-gray-600';
        },

        // —— 倒计时 ——
        countdownText(deadline) {
          if (!deadline) return '';
          const now = new Date();
          const end = new Date(deadline);
          const diff = Math.ceil((end - now) / (1000 * 60 * 60 * 24));
          if (diff <= 0) return '⏰ 已截止';
          if (diff === 1) return '⏰ 今日截止';
          return `⏰ 剩余${diff}天`;
        },
        countdownClass(deadline) {
          if (!deadline) return 'text-gray-400';
          const now = new Date();
          const end = new Date(deadline);
          const diff = Math.ceil((end - now) / (1000 * 60 * 60 * 24));
          if (diff <= 0) return 'text-red-500 font-medium';
          if (diff <= 3) return 'text-orange-500 font-medium';
          return 'text-gray-500';
        },

        // —— 收藏 ——
        toggleFav(bid, event) {
          const id = bid.id || bid._id;
          const title = bid.title || '';
          if (this.favedIds[id]) {
            delete this.favedIds[id];
            localStorage.removeItem('fav_' + id);
            localStorage.removeItem('fav_meta_' + id);
            window.__toast && window.__toast('已取消收藏', 'info');
          } else {
            this.favedIds[id] = true;
            localStorage.setItem('fav_' + id, 'true');
            localStorage.setItem('fav_meta_' + id, JSON.stringify({
              title,
              method: bid.method || '',
              source: bid.source || '',
              industry: bid.industry || '',
              region: bid.region || '',
              budget: bid.budget || '',
              date: bid.date || '',
              deadline: bid.deadline || '',
              savedAt: new Date().toISOString(),
            }));
          }
          if (event) event.stopPropagation();
        },
        isFav(id) {
          return !!this.favedIds[id];
        },

        isContentBlocked(content) {
          return content && (content.includes('页面访问提示') || content.includes('暂停访问') || content.includes('PDF 文件') || content.includes('pdf-pending') || content.includes('内容待提取'));
        },

        // —— 附件类型样式 ——
        attExtClass(ext) {
          const map = {
            'pdf': 'bg-red-50 text-red-600',
            'doc': 'bg-blue-50 text-blue-600',
            'docx': 'bg-blue-50 text-blue-600',
            'xls': 'bg-green-50 text-green-600',
            'xlsx': 'bg-green-50 text-green-600',
            'zip': 'bg-amber-50 text-amber-600',
            'rar': 'bg-amber-50 text-amber-600',
            'link': 'bg-sky-50 text-sky-600',
            'download': 'bg-purple-50 text-purple-600',
          };
          return map[ext] || 'bg-gray-50 text-gray-600';
        },
        attExtIcon(ext) {
          const map = {
            'pdf': '📄',
            'doc': '📝',
            'docx': '📝',
            'xls': '📊',
            'xlsx': '📊',
            'zip': '📦',
            'rar': '📦',
            'link': '🔗',
            'download': '📎',
          };
          return map[ext] || '📎';
        },

        // —— 判断是否为 NXZF 文件（需强制 download 属性） ——
        isNxzf(att) {
          if (!att || !att.local_file) return false;
          const name = att.name || att.local_file;
          return name.toUpperCase().endsWith('.NXZF');
        },

        // —— 来源文本颜色 ——
        sourceTextClass(source) {
          const map = {
            '国招平台': 'text-blue-600',
            '政府采购网': 'text-emerald-600',
            '省平台': 'text-purple-600',
            '招标代理': 'text-orange-600',
            '医院官网': 'text-rose-600',
            '高校官网': 'text-cyan-600',
            '招标投标公共服务平台': 'text-blue-600',
          };
          return map[source] || 'text-gray-500';
        }
      }
    }
  </script>

  <style>
    .bid-source-badge { font-size: 0.65rem; padding: 0.1rem 0.4rem; border-radius: 999px; }
  </style>

  <!-- Toast -->
  <div x-data="toastManager()">
    <div x-show="show" x-cloak
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-4"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 translate-y-4"
      class="fixed bottom-20 left-1/2 -translate-x-1/2 z-[60] px-5 py-2.5 rounded-xl shadow-lg text-sm font-medium pointer-events-none"
      :class="type === 'success' ? 'bg-emerald-600 text-white' : 'bg-gray-700 text-white'"
      x-text="message">
    </div>
  </div>

  <script>
    // 全局收藏管理器 — 使用 fav_{id} = true/false 存储在 localStorage
    window.favoriteManager = {
      getFavs() {
        const all = {};
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (key && key.startsWith('fav_')) {
            all[key] = localStorage.getItem(key) === 'true';
          }
        }
        return all;
      },
      isFaved(id) {
        return localStorage.getItem('fav_' + id) === 'true';
      },
      toggle(id, title) {
        const key = 'fav_' + id;
        const current = localStorage.getItem(key);
        if (current === 'true') {
          localStorage.setItem(key, 'false');
          window.__toast && window.__toast('已取消收藏', 'info');
        } else {
          localStorage.setItem(key, 'true');
          window.__toast && window.__toast('已收藏', 'success');
        }
        // Force Alpine re-evaluation by dispatching a custom event
        window.dispatchEvent(new CustomEvent('fav-changed'));
      },
      getCount() {
        let count = 0;
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (key && key.startsWith('fav_') && localStorage.getItem(key) === 'true') {
            count++;
          }
        }
        return count;
      }
    };

    function toastManager() {
      return {
        show: false,
        message: '',
        type: 'success',
        timeout: null,
        init() {
          window.__toast = (msg, type) => {
            this.message = msg;
            this.type = type || 'success';
            this.show = true;
            clearTimeout(this.timeout);
            this.timeout = setTimeout(() => { this.show = false; }, 2000);
          };
        }
      }
    }
  </script>

