  <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
  <link href="https://cdn.jsdelivr.net/npm/daisyui@5/theme/light.css" rel="stylesheet" type="text/css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://lib.baomitu.com/alpinejs/3.14.3/cdn.min.js" defer></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;600;700&display=swap');
    * { font-family: 'Noto Sans SC', -apple-system, sans-serif; }
    .hero-gradient { background: linear-gradient(135deg, #059669 0%, #10b981 50%, #34d399 100%); }
    .prose-content { white-space: normal; }
    .prose-content h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem; color: #111; }
    .prose-content h2 { font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; color: #1f2937; margin-top: 1.5rem; }
    .prose-content h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.5rem; color: #374151; }
    .prose-content p { margin: 0; }
    .prose-content ul, .prose-content ol { margin-bottom: 1rem; padding-left: 1.5rem; }
    .prose-content li { font-size: 0.95rem; line-height: 1.7; color: #4b5563; margin-bottom: 0.25rem; }
    .prose-content table { max-width: 100%; }
    .prose-content th, .prose-content td { font-size: 0.9rem; }
    .fade-in { animation: fadeIn 0.3s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    [x-cloak] { display: none !important; }
    /* 三点闪动动画 */
    @keyframes dotBlink {
      0%, 100% { opacity: 0.2; }
      50% { opacity: 1; }
    }
    .dot-blink { animation: dotBlink 1.2s infinite ease-in-out; }
    @media (prefers-color-scheme: dark) and (max-width: 767px) {
      body { background: #1f2937; }
      nav { background: #1f2937 !important; border-color: #374151 !important; }
      nav a, nav span { color: #d1d5db !important; }
      nav .text-gray-900 { color: #f3f4f6 !important; }
      [class*="bg-white"] { background: #374151 !important; border-color: #4b5563 !important; }
      [class*="text-gray-900"] { color: #f3f4f6 !important; }
      [class*="text-gray-500"], [class*="text-gray-400"] { color: #9ca3af !important; }
      [class*="text-emerald-600"] { color: #6ee7b7 !important; }
      [class*="bg-gray-50"] { background: #111827 !important; }
      [class*="bg-emerald-50"] { background: #064e3b !important; }
      [class*="border-gray-100"] { border-color: #374151 !important; }
      .prose-content p, .prose-content li, .prose-content td { color: #d1d5db !important; }
      .prose-content h1, .prose-content h2, .prose-content h3 { color: #f3f4f6 !important; }
      .prose-content th { background: #1f2937 !important; color: #d1d5db !important; }
      .prose-content th, .prose-content td { border-color: #4b5563 !important; }
    }
  </style>
