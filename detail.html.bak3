<!-- 工作日/非工作日 底部导航切换 -->
<script>
(async () => {
  const isNonWorkday = await HolidayUtils.init();
  if (isNonWorkday) {
    const homeLink = document.querySelector('nav a[href="/"]');
    const customerLink = document.querySelector('nav a[href="/customers"]');
    if (homeLink) {
      const dot = homeLink.querySelector('.absolute');
      if (dot) dot.style.display = 'none';
      const svg = homeLink.querySelector('svg');
      if (svg) svg.classList.replace('text-emerald-600', 'text-gray-400');
      const span = homeLink.querySelector('span');
      if (span) span.classList.replace('text-emerald-600', 'text-gray-400');
    }
    if (customerLink) {
      const dot = customerLink.querySelector('.absolute');
      if (!dot) {
        const d = document.createElement('span');
        d.className = 'absolute -top-1 w-1 h-1 rounded-full bg-emerald-600';
        customerLink.appendChild(d);
      } else {
        dot.style.display = '';
      }
      const svg = customerLink.querySelector('svg');
      if (svg) svg.classList.replace('text-gray-400', 'text-emerald-600');
      const span = customerLink.querySelector('span');
      if (span) span.classList.replace('text-gray-400', 'text-emerald-600');
    }
  }
})();
</script>

