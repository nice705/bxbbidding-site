e\" class=\"layui-input\" autocomplete=\"off\">-->\n<!--                                    </div>-->\n<!--                                </div>-->\n<!--                            </div>-->\n<!--                        </div>-->\n</div>\n<div class=\"layui-row\">\n<div class=\"layui-col-md8\">\n<div class=\"grid-demo grid-demo-bg1\">\n<div class=\"layui-inline\">\n<label class=\"layui-form-label\">发布时间</label>\n<div class=\"layui-input-inline\">\n<input autocomplete=\"off\" class=\"layui-input\" id=\"stateDate\" lay-verify=\"date\" name=\"date\" placeholder=\"请选择开始时间\" type=\"text\"/>\n<img src=\"/freecms-glht/site/juncai/resources/img/shijian.png\" style=\"display: inline-block;position: relative;left: 150px;bottom: 28px;\"/>\n</div>\n~\n<div class=\"layui-input-inline\">\n<input autocomplete=\"off\" class=\"layui-input\" id=\"endDate\" lay-verify=\"date\" name=\"date\" placeholder=\"请选择结束时间\" type=\"text\"/>\n<img src=\"/freecms-glht/site/juncai/resources/img/shijian.png\" style=\"display: inline-block;position: relative;left: 150px;bottom: 28px;\"/>\n</div>\n</div>\n</div>\n</div>\n<div class=\"layui-col-md4\" style=\"padding-left: 20px;\">\n<div class=\"grid-demo\" style=\"height: 55px\">\n<button class=\"layui-btn layui-btn-normal clickButton\" id=\"Inquire\" style=\"color: #555;\" type=\"button\">查询<img src=\"/freecms-glht/site/juncai/resources/img/chaxun.png\"/></button>\n<button class=\"layui-btn layui-btn-primary\" id=\"queryReset\" style=\"margin-left: 2px;\" type=\"button\">重置<img src=\"/freecms-glht/site/juncai/resources/img/chongzhi.png\"/></button>\n</div>\n</div>\n</div>\n</div>\n<!--数据显示-->\n<div class=\"searchBoxBottom\">\n<div class=\"noticeShowLabel\">\n标题\n<!--                        <span></span> -->\n发布时间\n</div>\n<ul class=\"noticeShowList\"></ul>\n<div class=\"pagination\" id=\"pagination\"></div>\n</div>\n</div>\n</div>\n</div>\n</section></body></html>", "method": "", "region": "国家级", "buyer": "", "deadline": "", "budget": "", "attachment