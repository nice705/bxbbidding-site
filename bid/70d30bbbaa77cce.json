t": "", "attachments": [{"name": "公共资源交易中心招标投标现场管理办法（公开征求意见稿）.doc", "path": "/attachments/2026/07/04/cb9161cc3192fa76.doc", "size": 189039}, {"name": "起草说明.doc", "path": "/attachments/2026/07/04/3c53b1f3f8419bf2.doc", "size": 150023}], "hasAttachment": true, "is_bidding": true}