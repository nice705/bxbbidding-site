px; */\r\n\t\t\tline-height:36px;\r\n\t\t\ttext-align:left;\r\n\t\t\tfont-size: 16px;\r\n\t\t\tfont-family:'微软雅黑';\r\n\t\t}\r\n\t\t.min_table td{\r\n\t\t\ttext-align:left;\r\n\t\t\tfont-size: 16px;\r\n\t\t\tfont-family:'微软雅黑';\r\n\t\t\tcolor: #000;\r\n\t\t}\r\n\t\t .min_table td{\r\n\t\t\tpadding-left: 25px;\r\n\t\t} \r\n\t\th4 {\r\n\t\t\tline-height: 20px;\r\n\t\t}\r\n\t</style> \n  <div id=\"createForm\"> \n   <div class=\"gw-paper\" style=\"width: 100%; margin:0 auto; padding-bottom:20px;\"> \n    <!--招标公告--开始  --> \n    <!--资格预审公告  --> \n    <!--公开招标公告  --> \n    <!--询价公告  --> \n    <!--竞争性谈判公告  --> \n    <!--竞争性磋商公告  --> \n    <!--单一来源公告  --> \n    <!--招标公告--结束  --> \n    <!--招标公告-------------开始  --> \n    <!--公开招标中标公告  --> \n    <!--邀请招标中标公告  --> \n    <!--竞争性谈判成交结果公告  --> \n    <!--竞争性磋商成交结果公告  --> \n    <!--询价采购成交结果公告 --> \n    <!--单一来源成交结果公告  --> \n    <!--中标公告 --- 结束  --> \n    <!--结果变更公告 --- 开始  --> \n    <!--更正公告  --> \n    <!--终止公告  --> \n    <p align=\"left\"> <strong align=\"left\">一、项目基本情况</strong> </p> \n    <p align=\"left\"> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<strong>采购项目编号：</strong>&nbsp;NXJH-2026-ZC025 </p> \n    <p align=\"left\"> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <strong>采购项目名称：</strong>&nbsp;灵武市教育体育局2026校园专职保安服务采购项目二次 </p> \n    <p align=\"left\"> <strong> 二、项目废标的原因 </strong> </p> \n    <p align=\"left\"> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;本项目部分投标人管理费报价存在偏离市场合理区间的情况，无法确定最低价是否能够实现本项目履约质量及管理目标的实现，并对本项目报价分评审的合理性产生影响，继续开展后续工作无法保障履约质量及管理目标的实现,本项目本次采购活动予以废标。后续重新开展市场调研并严格核算管理费成本后，依法重新组织采购工作。 </p> \n    <p align=\"left\"> <strong align=\"left\">三、其他补充事宜</strong> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </p> \n    <p align=\"left\"> <strong align=\"left\">四、凡对本次公告内容提出询问，请按以下方式联系</strong> </p> \n    <p align=\"left\"> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<strong>1.采购人信息</strong> </p> \n    <p align=\"left\"> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<strong>名称：</strong><label class=\"whi