-top: 24px; } .ann-index-block-wrapper .ann-index-block:last-of-type { margin-bottom: 20px; padding-bottom: 24px; } .ann-index-block > p { line-height: 2; font-weight: 500; } .bold-500 { font-weight: 500 !important; } .ann-index-block > p * { font-weight: normal; }</style> \n <div id=\"template-center-page\"> \n  <div class=\"ann-wrapper\"> \n   <div class=\"ann-block\"> \n    <p class=\"ann-block-title PlaygroundEditorTheme__paragraph\" dir=\"ltr\"><span style=\"white-space: pre-wrap;\">一、项目基本情况</span></p> \n    <div class=\"ann-content\"> \n     <p class=\"t-indent-2 PlaygroundEditorTheme__paragraph\" dir=\"ltr\"><span style=\"white-space: pre-wrap;\">原公告的采购项目编号：</span><span class=\"bookmark-item uuid-1591621076409 code-00004 addWord Template__bookmark single-line-text-input-box-cls\">330000263030090000176-NBGODOHSZBF26001-8</span></p> \n     <p class=\"t-indent-2 PlaygroundEditorTheme__paragraph\" dir=\"ltr\"><span style=\"white-space: pre-wrap;\">原公告的采购项目名称：</span><span class=\"bookmark-item uuid-1591621095532 code-00003 addWord Template__bookmark single-line-text-input-box-cls\">浙江万里学院具身智能实验室建设设备采购项目</span></p> \n     <p class=\"t-indent-2 PlaygroundEditorTheme__paragraph\" dir=\"ltr\"><span style=\"white-space: pre-wrap;\">首次公告日期：</span><span class=\"bookmark-item uuid-1591621110372 code-32001 addWord Template__bookmark date-selection-cls\">2026年06月22日</span></p> \n    </div> \n   </div> \n   <div class=\"ann-block\"> \n    <p class=\"ann-block-title PlaygroundEditorTheme__paragraph\" dir=\"ltr\"><span style=\"white-space: pre-wrap;\">二、更正信息</span></p> \n    <div class=\"ann-content\"> \n     <p class=\"t-indent-2 PlaygroundEditorTheme__paragraph\" dir=\"ltr\"><span style=\"white-space: pre-wrap;\">更正事项：</span><span class=\"bookmark-item uuid-1591876457489 code-AM014corrections addWord Template__bookmark single-line-text-input-box-cls\">更正采购文件</span></p> \n     <p class=\"sub\" dir=\"ltr\"><span style=\"white-space: pre-wrap;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;更正内容：</span><span class=\"bookmark-item uuid-1591876462989 code-31005 addWord Template__bookmark\">\n       <table class=\"form-panel-input-cls\" style=\"text-align: center;\" width=\"100%\">\n        <tr width=\"100%\" style=\"vertical-align: middle;background-color: #eeeeee;\">\n         <td width=\"25.0%\" style=\"word-break:break-all; \">序号</td>\n         <td width=\"25.0%\" style=\"word-break:break-all; \">更正项</td>\n         <td width=\"25.0%\" style=\"word-break:break-all; \">更正前内容</td>\n         <td width=\"25.0%\" style=\"word-break:break-all; \" colSpan=\"1\">更正后内容</td>\n        </tr>\n        <tr width=\"100%\" style=\"vertical-align: middle;\">\n         <td width=\"25.0%\" style=\"word-break:break-all; \">1</td>\n         <td width=\"25.0%\" style=\"word-break:break-all; \">《第三章 采购需求》“8.装修”</td>\n         <td width=\"25.0%\" style=\"word-break:break-all; \">主要涉及电脑走线，按照机器人实训实验室标准进行场地改造装修，满足设备安装、实训教学、安全及环境整洁规范要求。</td>\n         <td width=\"25.0%\" style=\"word-break:break-all; \" colSpan=\"1\">主要涉及电脑走线，实验室布线执行机器人实训实验室通用安全规范（全部为暗线），强弱电分离敷设为行业通用标准（均涉及），按行业常规安全标准综合考虑，满足设备安装、实训教学、安全及环境整洁规范要求。<br/>实验室面积约100平方，具体布线尺寸信息，投标人可以根据自身经验决定，无硬性规定。</td>\n        </tr>\n        <tr width=\"100%\" style=\"vertical-align: middle;\">\n         <td width=\"25.0%\" style=\"word-break:break-all; \">2</td>\n         <td width=\"25.0%\" style=\"word-break:break-all; \">《第四章 评标办法及评分标准》“八、评分标准表”</td>\n         <td width=\"25.0%\" style=\"word-break:break-all; \">技术参数：依据招标文件第三章《采购需求（技术参数）》对投标文件中“技术参数”进行评审：<br/>所投产品技术参数全部满足招标文件第三章《采购需求》的得基本分15分；在此基础上，标注“★”的条款每负偏离或未响应一项条款扣1分，未标注“★”的条款每负偏离或未响应一项条款扣0.5分。<br/>注：负偏离技术参数项按最小序号计。若当扣减至0分（或以下）时，其投标文件作无效标处理，不再进行评审。</td>\n         <td width=\"25.0%\" style=\"word-break:break-all; \" colSpan=\"1\">技术参数：依据招标文件第三章《采购需求（技术参数）》对投标文件中“技术参数”进行评审：<br/>所投产品技术参数全部满足招标文件第三章《采购需求》的得基本分15分；在此基础上，标注“★”的条款每负偏离或未响应一项条款扣0.5分，未标注“★”的条款每负偏离或未响应一项条款扣0.2分。<br/>注：负偏离技术参数项按最小序号计。若当扣减至0分（或以下）时，其投标文件作无效标处理，不再进行评审。</td>\n        </tr>\n        <tr width=\"100%\" style=\"vertical-align: middle;\">\n         <td width=\"25.0%\" style=\"word-break:break-all; \">3</td>\n         <td width=\"25.0%\" style=\"word-break:break-all; \">开标时间</td>\n         <td width=\"25.0%\" style=\"word-break:break-all; \">开标时间：2026年7月13日14点00分（北京时间）</td>\n         <td width=\"25.0%\" style=\"word-break:break-all; \" colSpan=\"1\">开标时间：2026年7月28日14点00分（北京时间）</td>\n        </tr>\n       </table></span></p> \n     <p class=\"t-indent-2 PlaygroundEditorTheme__paragraph\" dir=\"ltr\"><span style=\"white-space: pre-wrap;\">更正日期：</span><span class=\"bookmark-item uuid-1593542079222 code-AM014jj002 addWord Template__bookmark date-selection-cls\">2026年07月07日</span></p> \n    </div> \n   </div> \n   <div class=\"ann-block\"> \n    <p class=\"ann-block-title PlaygroundEditorTheme__paragraph\" dir=\"ltr\"><span style=\"white-space: pre-wrap;\">三、其他补充事宜</span></p> \n    <div class=\"ann-content\"> \n     <p class=\"t-indent-2 PlaygroundEditorTheme__paragraph\" dir=\"ltr\"><span class=\"bookmark-item uuid-1591621143059 code-81205 addWord Template__bookmark multi-line-text-input-box-cls\">其余内容不作调整，特此通知。</span></p> \n    </div> \n   </div> \n   <div class=\"ann-block\"> \n    <p class=\"ann-block-title PlaygroundEditorTheme__paragraph\" dir=\"ltr\"><span style=\"white-space: pre-wrap;\">四、对本次采购提出询问、质疑、投诉，请按以下方式联系。</span></p> \n    <div class=\"ann-content\"> \n     <p class=\"t-indent-2 PlaygroundEditorTheme__paragraph\" dir=\"ltr\"><span style=\"white-space: pre-wrap;\">1.采购人信息</span></p> \n     <p class=\"t-indent-2 PlaygroundEditorTheme__paragraph\" dir=\"ltr\"><span style=\"white-space: pre-wrap;\">名&nbsp;&nbsp;&nbsp;&nbsp;称：</span><span class=\"bookmark-item uuid-1596004663203 code-00014 editDisable Template__bookmark interval-text-box-cls readonly\">浙江万里学院</span></p> \n     <p class=\"t-indent-2 PlaygroundEditorTheme__paragraph\" dir=\"ltr\"><span style=\"white-space: pre-wrap;\">地&nbsp;&nbsp;&nbsp;&nbsp;址：</span><span class=\"bookmark-item uuid-1596004672274 