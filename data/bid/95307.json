>\n<td>\n<p><span>2180321.84元</span></p>\n</td>\n<td>\n<p><span>2180321.84元</span></p>\n</td>\n<td>\n<p><span>达到招标文件的要求</span></p>\n</td>\n<td>\n<p><span>达到招标文件的要求</span></p>\n</td>\n<td>\n<p><span>93.04</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><span>第二名</span></p>\n</td>\n<td>\n<p><span>深圳众大建设工程有限公司</span></p>\n</td>\n<td>\n<p><span>2240095.02元</span></p>\n</td>\n<td>\n<p><span>2240095.02元</span></p>\n</td>\n<td>\n<p><span>达到招标文件的要求</span></p>\n</td>\n<td>\n<p><span>达到招标文件的要求</span></p>\n</td>\n<td>\n<p><span>90.76</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><span>第三名</span></p>\n</td>\n<td>\n<p><span>重庆东桥建筑工程有限公司</span></p>\n</td>\n<td>\n<p><span>2240095.02元</span></p>\n</td>\n<td>\n<p><span>2240095.02元</span></p>\n</td>\n<td>\n<p><span>达到招标文件的要求</span></p>\n</td>\n<td>\n<p><span>达到招标文件的要求</span></p>\n</td>\n<td>\n<p><span>89.63</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><span>中标候选人响应招标文件要求的资格能力条件</span></p>\n</td>\n<td colspan=\"6\">\n<p><span>1．中标候选人的资质；</span></p>\n<p><span>（1）第一中标候选人：建筑工程施工总承包</span><span>特</span><span>级</span></p>\n<p><span>（2）第二中标候选人：建筑工程施工总承包</span><span>二</span><span>级</span></p>\n<p><span>（3）第三中标候选人：建筑工程施工总承包</span><span>二</span><span>级</span></p>\n<p><span>2．中标候选人项目负责人及其他管理人员姓名、相关证书名称和编号：详见附件；</span></p>\n<p><span>3．其他资格能力条件：满足招标文件要求。</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><span>中标候选人评标情况</span></p>\n</td>\n<td colspan=\"6\">\n<p><span>1．投标人撤销投标文件或者部分投标被否决导致有效投标人不足三个的竞争性论证情况：<span>无；</span></span></p>\n<p><span>2．其他情况：无。</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><span>招标文件规定应公示的其他内容</span></p>\n</td>\n<td colspan=\"6\">\n<p><span>1</span><span>．</span><span>被评标委员会否决投标的投标人名称、否决依据和原因：</span></p>\n<p><span>①响应性评审不合格投标人名称及原因分别如下:重庆万盟建筑工程有限责任公司</span></p>\n<p><span>因评审点投标保证金不满足招标文件要求，根据招标文件《否决投标情形一览表》<span>A-14</span></span></p>\n<p><span>投标人应按投标人须知前附表第3.4款规定递交投标保证金，并作为其投标文件的组成部分，否则由评标委员会作否决投标处理。<br/>\n</span></p>\n<p><span>2</span><span>．</span><span>需要公示的其他内容</span><span>：无</span><span>。</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><span>提出异议的渠道和方式</span></p>\n</td>\n<td colspan=\"6\">\n<p><span>投标人或者其他利害关系人对评标结果有异议的，应在中标候选人公示期内以书面形式向招标人：重庆工商大学(联系人：</span><span>李</span><span>老师，联系电话：023-6276</span><span>8357</span><span>）提出异议。</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><span>监督部门名称及监督电话</span></p>\n</td>\n<td colspan=\"6\">\n<p><span>监督部门：</span><u><span>重庆工商大学党政办 </span></u></p>\n<p><span>联系电话：</span><u><span>023-62769900 </span></u></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"4\">\n<p><span>招标人（盖章）： </span><span><br/>\n</span><span><br/>\n</span></p>\n<p><span>重庆工商大学</span></p>\n<p><span>2026</span><span>年</span><span>6</span><span>月</span><span>26</span><span>日</span></p>\n</td>\n<td colspan=\"3\">\n<p><span>招标代理机构（盖章）： </span><span><br/>\n</span><span><br/>\n</span></p>\n<p><span>垚鑫工程项目管理有限公司</span></p>\n<p><span>2026</span><span>年</span><span>6</span><span>月</span><span>26</span><span>日</span></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"7\">\n<p><span>注：一、公示内容应当包含：1</span><span>．</span><span>评标委员会各成员对中标候选人投标文件商务部分、技术部分、投标报价等的评审结论、打分情况；2</span><span>．</span><span>中标候选人的资质、业绩，项目负责人及其他管理人员姓名、业绩、相关证书名称和编号；3</span><span>．</span><span>被评标委员会否决投标的投标人名称、否决依据和原因；4</span><span>．</span><span>法律法规规章规定的其他内容。</span></p>\n<p><span>评标委员会成员姓名应当以编码标注的方式替代。</span></p>\n<p><!--[if !supportLists]--><span><span>二、</span></span><!--[endif]--><span>评标委员会对中标候选人投标文件的打分情况、中标候选人及其管理人员的业绩（包括资格业绩和商务加分业绩）、中标候选人管理人员的相关证书名称和编号公示信息等内容较多时，可以以汇总表形式（详见附表1、2、3）公示。</span></p>\n<p><!--[if !supportLists]--><span><span>三、</span></span><!--[endif]--><span>中标候选人是联合体的，“中标候选人名称”中联合体各方的名称均应填写。</span></p>\n</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n<span><br/>\n</span>\n<p><span>附表</span><span>1</span></p>\n<p><span>评标委员会成员对中标候选人的打分情况公示表</span></p>\n<div>\n<table class=\"bid-table\" style=\"width:100.86%\">\n<tbody>\n<tr>\n<td>\n<p><span>中标候选人</span></p>\n<p><span>排序</span></p>\n</td>\n<td>\n<p><span>中标候选人名称</span></p>\n</td>\n<td>\n<p><span>打分分项</span></p>\n</td>\n</tr></tbody></table></div></div>", "html": "", "method": "中标候选人", "region": "重庆", "buyer": 